sort
  Axis = struct X | Y | Z;
  % NOTE(Jorens): 
  %  -> UnexpectedItemOnSlot: we just cancel the request and update the
  %                           storage.
  %  -> NoItemOnSlot: we just cancel the request and update the occupancy.
  DisplayValue = struct 
     displaySlot(Slot)
   | ItemNotFound
   | StorageFull 
   | DropOffBusy
   | RequestAccepted
   | OperationCompleted;
  Mode = struct Idle | Working | Emergency | Recovery;
  MotorState = struct Forward | Backward | Stop;
  Movement = struct movement(axis : Axis, state : MotorState);
  Position = struct pos(x : Int, y : Int, z: Int);
  Slot = Nat;

map
  oppositeState     : MotorState -> MotorState; % add to spec.
  slotRoute         : Slot -> List(Movement);
  reverseRoute      : List(Movement) -> List(Movement);
  routeEndpointFrom : Position # List(Movement) -> Position;
  movePos           : Movement # Position -> Position;
  slotAmount        : Nat;
  find_empty        : Nat # FSet(Slot) -> Nat;


var
  m   : Movement;
  ms  : List(Movement);
  p   : Position;
  s   : Nat; 
  occ : FSet(Slot);
eqn
  
  oppositeState(Forward)  = Backward;
  oppositeState(Backward) = Forward;
  oppositeState(Stop)     = Stop;

  reverseRoute([]) = [];
  reverseRoute(m |> ms) =
      reverseRoute(ms) ++ [movement(axis(m), oppositeState(state(m)))];

  slotRoute(0) = 
    [
      movement(X, Backward),
      movement(Y, Forward),
      movement(Y, Forward),
      movement(X, Forward)
    ];
  slotRoute(1) = 
    [
      movement(X, Backward),
      movement(Y, Forward),
      movement(Y, Forward),
      movement(Z, Forward),
      movement(X, Forward)
    ];
  slotRoute(2) = 
    [
      movement(X, Backward),
      movement(Y, Forward),
      movement(Y, Forward),
      movement(Z, Backward),
      movement(X, Forward)
    ];

  routeEndpointFrom(p, []) = p;
  routeEndpointFrom(p, m |> ms) = routeEndpointFrom(movePos(m, p), ms);
  movePos(m, p) =
      if(
        state(m) == Forward,
        if(
          axis(m) == X,
          pos(x(p) + 1, y(p), z(p)),
          if(
            axis(m) == Y,
            pos(x(p), y(p) + 1, z(p)),
            pos(x(p), y(p), z(p) + 1)
          )
        ),
        if(
          state(m) == Backward,
          if(
              axis(m) == X,
              pos(x(p) - 1, y(p), z(p)),
              if(
                  axis(m) == Y,
                  pos(x(p), y(p) - 1, z(p)),
                  pos(x(p), y(p), z(p) - 1)
              )
          ),
          p
        )
      );

  slotAmount = 3;

  (s >= slotAmount) 
    -> find_empty(s, occ) = slotAmount;
  (s < slotAmount) && (s in occ) 
    -> find_empty(s, occ) = find_empty(s + 1, occ);
  (s < slotAmount) && !(s in occ)
    -> find_empty(s, occ) = s;

act

  setMovement       : Movement;
  gridReached       : Axis;
  engageGripper, disengageGripper;
  objectAtPickup    : Bool;
  objectInGripper   : Bool;
  requestStorage;
  requestRetrieval  : Nat;
  storageComplete   : Slot;
  retrievalComplete : Slot;
  setDisplay        : DisplayValue;
  setErrorLight     : Bool;
  setEmergencyLight : Bool;
  emergencyPressed;
  emergencyReleased;
  resetError;

  s_initiateEmergency, r_initiateEmergency, comm_initiateEmergency;
  s_initiateRecovery, r_initiateRecovery, comm_initiateRecovery;
  s_acceptRequest, r_acceptRequest, comm_acceptRequest: Slot;
  s_rejectRequest, r_rejectRequest, comm_rejectRequest: Slot;
  s_requestPickupSlot, r_requestPickupSlot, comm_requestPickupSlot: Slot;

  s_requestHandout, r_requestHandout, comm_requestHandout;

  % s_requestReturnPickup, r_requestReturnPickup, comm_requestReturnPickup;

  s_requestStoreSlot, r_requestStoreSlot, comm_requestStoreSlot;
  s_operationCompleted, r_operationCompleted, comm_operationCompleted;
  s_armMoveToSlot, r_armMoveToSlot, comm_armMoveToSlot : Slot;
  s_armReturnToPickup, r_armReturnToPickup, comm_armReturnToPickup : Slot;
  s_armOperationCompleted, r_armOperationCompleted, comm_armOperationCompleted;

proc

  EmergencyController(isEmergency: Bool) =
    !(isEmergency) ->
      emergencyPressed .
      s_initiateEmergency .
      EmergencyController(true)
    +
    isEmergency ->
      emergencyReleased .
      s_initiateRecovery . 
      s_requestHandout .
      EmergencyController(false);

  UserInterface =
    (
      requestStorage . s_requestStoreSlot .
      (
        sum slot: Slot .
        (slot < slotAmount) ->
          (
            r_acceptRequest(slot) . 
            r_operationCompleted .
            setDisplay(displaySlot(slot)) 
            + 
            r_rejectRequest(slot) . 
            setDisplay(StorageFull)
          )
      ) .
      UserInterface
    ) 
    +
    (
      sum slot: Slot . (slot < slotAmount) ->
        requestRetrieval(slot) . s_requestPickupSlot(slot) .
        (
          r_acceptRequest(slot) . r_operationCompleted .
                                  setDisplay(displaySlot(slot)) + 
          r_rejectRequest(slot) . setDisplay(ItemNotFound)
        ) .
        UserInterface
    );

  StorageController(occupancy: FSet(Slot)) = 
    (
      sum slot: Slot . (slot < slotAmount) ->
        (
          r_requestPickupSlot(slot) .
            (
              !(slot in occupancy) ->
                s_rejectRequest(slot) .
                StorageController(occupancy)
              +
              (slot in occupancy) ->
                s_acceptRequest(slot) . s_armMoveToSlot(slot) .
                r_armOperationCompleted . s_operationCompleted .
                StorageController(occupancy - {slot})
            )
        )
    )
    +
    (
      sum empty_slot: Nat . 
      (empty_slot == find_empty(0, occupancy)) ->
        (
          r_requestStoreSlot .
          (
            (empty_slot < slotAmount) ->
              s_acceptRequest(empty_slot) .
              s_armMoveToSlot(empty_slot) .
              r_armOperationCompleted .
              s_operationCompleted .
              StorageController(occupancy + {empty_slot})
            +
            (empty_slot == slotAmount) ->
              s_rejectRequest(empty_slot) .
              StorageController(occupancy)
          )
        )
    ) +
    (
      r_requestHandout . 
      r_armOperationCompleted . 
      StorageController(occupancy)
    );

  FollowRoute(
    trace: List(Movement),
    route: List(Movement),
    movingToSlot: Bool
  ) =
    (route == []) ->
      s_armOperationCompleted . 
      (movingToSlot -> ArmController(trace) <> ArmController(route))
    <>
      (
        setMovement(head(route)) + 
        (
          r_initiateEmergency .
          movingToSlot 
            -> ArmController(reverseRoute(trace)) 
            <> ArmController(route)
        )
      ) .
      (
        gridReached(axis(head(route))) .
        FollowRoute(trace ++ [head(route)], tail(route), movingToSlot)
        +
        r_initiateEmergency .
        setMovement(movement(axis(head(route)), Stop)) .
        movingToSlot 
          % NOTE(Jorens): We did not finish movement (a, s)
          % If-case: we take the current movement backwards and continue with
          % the reverse.
          % Else-case: We need to finish the current move and continue the
          % route, which just correspond to the route.
          % trace: X+, X+, Y+, Z+
          % head:  Y+
          % route: ....
          -> ArmController(reverseRoute(trace ++ [head(route)])) 
          <> ArmController(route)
      );

  ArmController(returnRoute: List(Movement)) = 
    (
      r_initiateRecovery . 
      FollowRoute([], returnRoute, false)
    )
    +
    (
      r_requestHandout . 
      disengageGripper .
      ArmController([])
    )
    +
    (
      sum slot: Slot . (slot < slotAmount) -> 
        (
          r_armMoveToSlot(slot) .
          FollowRoute([], slotRoute(slot), true) 
          +
          r_armReturnToPickup(slot) .
          FollowRoute([], reverseRoute(slotRoute(slot)), false)
        )
    );

init
  allow(
    {
      setMovement, gridReached, engageGripper, disengageGripper,
      objectAtPickup, objectInGripper, requestStorage, requestRetrieval,
      storageComplete, retrievalComplete, setDisplay, setErrorLight,
      setEmergencyLight, emergencyPressed, emergencyReleased, resetError,
      comm_initiateEmergency, comm_initiateRecovery, comm_acceptRequest,
      comm_rejectRequest, comm_requestPickupSlot, 
      comm_requestStoreSlot, comm_operationCompleted,
      comm_armMoveToSlot, comm_armReturnToPickup, comm_armOperationCompleted,
      comm_requestHandout
    },
    comm(
      {
        s_acceptRequest         | r_acceptRequest         -> comm_acceptRequest,
        s_rejectRequest         | r_rejectRequest         -> comm_rejectRequest,
        s_requestPickupSlot     | r_requestPickupSlot     -> comm_requestPickupSlot,
        % s_requestReturnPickup | r_requestReturnPickup   -> comm_requestReturnPickup,
        s_requestStoreSlot      | r_requestStoreSlot      -> comm_requestStoreSlot,
        s_operationCompleted    | r_operationCompleted    -> comm_operationCompleted,
        s_armMoveToSlot         | r_armMoveToSlot         -> comm_armMoveToSlot,
        s_armReturnToPickup     | r_armReturnToPickup     -> comm_armReturnToPickup,
        s_armOperationCompleted | r_armOperationCompleted -> comm_armOperationCompleted,
        s_initiateEmergency     | r_initiateEmergency     -> comm_initiateEmergency,
        s_initiateRecovery      | r_initiateRecovery      -> comm_initiateRecovery,
        s_requestHandout        | r_requestHandout        -> comm_requestHandout
      },
      EmergencyController(false)
      ||
      UserInterface   
      ||
      StorageController({}) 
      || 
      ArmController([])
    )
  );
