sort
  Axis = struct XAxis | YAxis | ZAxis;
  % NOTE(Jorens): 
  %  -> UnexpectedItemOnSlot: we just cancel the request and update the
  %                           storage.
  %  -> NoItemOnSlot: we just cancel the request and update the occupancy.
  DisplayValue = struct 
     displaySlot(Slot)
   | ItemNotFound
   | StorageFull 
   | DropOffBusy
   | RequestAccepted
   | OperationCompleted;
  Mode = struct Idle | Working | Emergency | Recovery;
  MotorState = struct Forward | Backward | Stop;
  Movement = struct movement(axis : Axis, state : MotorState);
  Position = struct pos(x : Int, y : Int, z: Int);
  Slot = Nat;

map
  oppositeState     : MotorState -> MotorState; % add to spec.
  slotRoute         : Slot -> List(Movement);
  reverseRoute      : List(Movement) -> List(Movement);
  routeEndpointFrom : Position # List(Movement) -> Position;
  movePos           : Movement # Position -> Position;
  slotAmount        : Nat;
  find_empty        : Nat # FSet(Slot) -> Nat;

var
  m   : Movement;
  ms  : List(Movement);
  p   : Position;
  s   : Nat; 
  occ : FSet(Slot);
eqn
  
  oppositeState(Forward)  = Backward;
  oppositeState(Backward) = Forward;
  oppositeState(Stop)     = Stop;

  reverseRoute([]) = [];
  reverseRoute(m |> ms) =
      reverseRoute(ms) ++ [movement(axis(m), oppositeState(state(m)))];

  slotRoute(0) = 
    [
      movement(XAxis, Backward),
      movement(YAxis, Forward),
      movement(YAxis, Forward),
      movement(XAxis, Forward)
    ];
  slotRoute(1) = 
    [
      movement(XAxis, Backward),
      movement(YAxis, Forward),
      movement(YAxis, Forward),
      movement(ZAxis, Forward),
      movement(XAxis, Forward)
    ];
  slotRoute(2) = 
    [
      movement(XAxis, Backward),
      movement(YAxis, Forward),
      movement(YAxis, Forward),
      movement(ZAxis, Backward),
      movement(XAxis, Forward)
    ];

  routeEndpointFrom(p, []) = p;
  routeEndpointFrom(p, m |> ms) = routeEndpointFrom(movePos(m, p), ms);
  movePos(m, p) =
      if(
        state(m) == Forward,
        if(
          axis(m) == XAxis,
          pos(x(p) + 1, y(p), z(p)),
          if(
            axis(m) == YAxis,
            pos(x(p), y(p) + 1, z(p)),
            pos(x(p), y(p), z(p) + 1)
          )
        ),
        if(
          state(m) == Backward,
          if(
              axis(m) == XAxis,
              pos(x(p) - 1, y(p), z(p)),
              if(
                  axis(m) == YAxis,
                  pos(x(p), y(p) - 1, z(p)),
                  pos(x(p), y(p), z(p) - 1)
              )
          ),
          p
        )
      );

  slotAmount = 3;
  (s >= slotAmount) -> find_empty(s, occ) = slotAmount;
  (s < slotAmount) && !(s in occ) -> find_empty(s, occ) = s;
  (s < slotAmount) && (s in occ) 
    -> find_empty(s, occ) = find_empty(s + 1, occ);

act
  engageGripper, disengageGripper, requestStorage,
  emergencyPressed, emergencyReleased, resetError;
  setMovement : Movement;
  gridReached : Axis;
  setErrorLight, setEmergencyLight, objectAtPickup, objectInGripper : Bool;
  requestRetrieval: Nat;
  storageComplete, retrievalComplete : Slot;
  setDisplay: DisplayValue;

  s_armEmergency, r_armEmergency, comm_armEmergency;
  s_armRecovery, r_armRecovery, comm_armRecovery;
  s_requestStoreSlot, r_requestStoreSlot, comm_requestStoreSlot;
  s_operationCompleted, r_operationCompleted, comm_operationCompleted;
  s_armOperationCompleted, r_armOperationCompleted, comm_armOperationCompleted;
  s_acceptRequest, r_acceptRequest, comm_acceptRequest,
  s_rejectRequest, r_rejectRequest, comm_rejectRequest,
  s_requestPickupSlot, r_requestPickupSlot, comm_requestPickupSlot,
  s_armMoveToSlot, r_armMoveToSlot, comm_armMoveToSlot,
  s_armRequestReturn,  r_armRequestReturn,  comm_armRequestReturn,
  s_armRequestPickup,  r_armRequestPickup,  comm_armRequestPickup,
  s_armRequestHandoff, r_armRequestHandoff, comm_armRequestHandoff : Slot;    

proc

  EmergencyController(isEmergency: Bool) =
    !(isEmergency) ->
      emergencyPressed .
      s_armEmergency .
      EmergencyController(true)
    +
    isEmergency ->
      emergencyReleased .
      s_armRecovery . 
      EmergencyController(false);

  UserInterface =
    (
      requestStorage . s_requestStoreSlot .
      (
        r_rejectRequest(slotAmount) . setDisplay(StorageFull) .
        UserInterface
        +
        sum slot: Slot . (slot < slotAmount) ->
          (
            r_acceptRequest(slot) .
            r_operationCompleted .
            setDisplay(displaySlot(slot)) .
            UserInterface
          )
      )
      +
      sum slot: Slot . (slot < slotAmount) ->
        requestRetrieval(slot) . s_requestPickupSlot(slot) .
          (
            r_rejectRequest(slot) . setDisplay(ItemNotFound) .
            UserInterface
            +
            r_acceptRequest(slot) . r_operationCompleted .
            setDisplay(displaySlot(slot)) . UserInterface
          )
    );

  StorageController(occupancy: FSet(Slot)) =
    (
      sum slot: Slot . (slot < slotAmount && slot in occupancy) ->
        (
          r_requestPickupSlot(slot) . s_acceptRequest(slot) .
          s_armMoveToSlot(slot)     . r_armOperationCompleted .
          s_armRequestPickup(slot)  . r_armOperationCompleted .
          s_armRequestReturn(slot)  . r_armOperationCompleted .
          s_armRequestHandoff(slot) . r_armOperationCompleted .
          s_operationCompleted . StorageController(occupancy - {slot})
        )
    )
    +
    (
      sum empty_slot: Nat .
      (empty_slot == find_empty(0, occupancy) && empty_slot < slotAmount) ->
        (
          r_requestStoreSlot              . s_acceptRequest(empty_slot) .
          s_armRequestPickup(empty_slot)  . r_armOperationCompleted .
          s_armMoveToSlot(empty_slot)     . r_armOperationCompleted .
          s_armRequestHandoff(empty_slot) . r_armOperationCompleted .
          s_armRequestReturn(empty_slot)  . r_armOperationCompleted .
          s_operationCompleted . StorageController(occupancy + {empty_slot})
        )
    );

  ArmFollowRoute(route: List(Movement)) =
    (route == []) ->
      (
        s_armOperationCompleted . ArmController
        +
        r_armEmergency . r_armRecovery . ArmFollowRoute(route)
      )
    <>
      (
        (
          r_armEmergency . r_armRecovery . ArmFollowRoute(route)
        )
        +
        (
          setMovement(head(route)) .
          (
            gridReached(axis(head(route))) .
            setMovement(movement(axis(head(route)), Stop)) .
            ArmFollowRoute(tail(route))
            +
            r_armEmergency .
            setMovement(movement(axis(head(route)), Stop)) .
            r_armRecovery .
            ArmFollowRoute(route)
          )
        )
      );

  ArmController = 
    (
      r_armEmergency . r_armRecovery . ArmController
    )
    +
    (
      sum s: Slot . r_armMoveToSlot(s). ArmFollowRoute(slotRoute(s))
    )
    +
    (
      sum s: Slot . r_armRequestReturn(s) .
      ArmFollowRoute(reverseRoute(slotRoute(s)))
    )
    +
    (
      sum s: Slot . r_armRequestPickup(s)  . engageGripper .
      s_armOperationCompleted . ArmController
    )
    +
    (
      sum s: Slot . r_armRequestHandoff(s) . disengageGripper .
      s_armOperationCompleted . ArmController
    );

init
  allow(
    {
      setMovement, gridReached, engageGripper, disengageGripper,
      objectAtPickup, objectInGripper, requestStorage, requestRetrieval,
      storageComplete, retrievalComplete, setDisplay, setErrorLight,
      setEmergencyLight, emergencyPressed, emergencyReleased, resetError,
      comm_acceptRequest, comm_rejectRequest, comm_requestPickupSlot,
      comm_requestStoreSlot, comm_operationCompleted, comm_armMoveToSlot,
      comm_armEmergency, comm_armRecovery, comm_armRequestReturn,
      comm_armRequestPickup, comm_armRequestHandoff, comm_armOperationCompleted
    },
    comm(
      {
        s_acceptRequest | r_acceptRequest -> comm_acceptRequest,
        s_rejectRequest | r_rejectRequest -> comm_rejectRequest,
        s_requestPickupSlot | r_requestPickupSlot -> comm_requestPickupSlot,
        s_requestStoreSlot | r_requestStoreSlot -> comm_requestStoreSlot,
        s_operationCompleted | r_operationCompleted -> comm_operationCompleted,
        s_armMoveToSlot | r_armMoveToSlot -> comm_armMoveToSlot,
        s_armOperationCompleted | r_armOperationCompleted 
          -> comm_armOperationCompleted,
        s_armEmergency | r_armEmergency -> comm_armEmergency,
        s_armRecovery | r_armRecovery -> comm_armRecovery,
        s_armRequestReturn  |  r_armRequestReturn ->  comm_armRequestReturn,
        s_armRequestPickup  |  r_armRequestPickup ->  comm_armRequestPickup,
        s_armRequestHandoff | r_armRequestHandoff -> comm_armRequestHandoff
      },
      (
        EmergencyController(false)
        ||
        UserInterface
        ||
        StorageController({}) 
        || 
        ArmController
      )
    )
  );
