sort
  Axis = struct XAxis | YAxis | ZAxis;
  Rejection = struct NoRejection | NothingToPick | SlotEmpty | SlotBusy | StorageFull | HandoffBusy;
  DisplayValue = struct reject(Rejection) | accept(Slot) | complete(Slot);
  MotorState = struct Forward | Backward | Stop;
  Movement = struct movement(axis : Axis, state : MotorState);
  Slot = Nat;
  Position = struct pos(x : Int, y : Int, z: Int);
  Held = struct Nothing | Pickup | item(Slot);

map
  oppositeState     : MotorState -> MotorState; % add to spec.
  slotRoute         : Slot -> List(Movement);
  slotPosition      : Slot -> Position;
  reverseRoute      : List(Movement) -> List(Movement);
  routeEndpointFrom : Position # List(Movement) -> Position;
  movePos           : Movement # Position -> Position;
  slotAmount        : Nat;
  find_empty        : Nat # FSet(Slot) -> Nat;

var
  m   : Movement;
  ms  : List(Movement);
  p   : Position;
  s   : Slot; 
  occ : FSet(Slot);

eqn
  
  oppositeState(Forward)  = Backward;
  oppositeState(Backward) = Forward;
  oppositeState(Stop)     = Stop;

  reverseRoute([]) = [];
  reverseRoute(m |> ms) =
      reverseRoute(ms) ++ [movement(axis(m), oppositeState(state(m)))];

  slotRoute(0) = 
    [
      movement(XAxis, Backward), movement(YAxis, Forward),
      movement(YAxis, Forward), movement(XAxis, Forward)
    ];
  slotRoute(1) = 
    [
      movement(XAxis, Backward), movement(YAxis, Forward),
      movement(YAxis, Forward), movement(ZAxis, Forward),
      movement(XAxis, Forward)
    ];
  slotRoute(2) = 
    [
      movement(XAxis, Backward), movement(YAxis, Forward),
      movement(YAxis, Forward), movement(ZAxis, Backward),
      movement(XAxis, Forward)
    ];

  slotPosition(s) = routeEndpointFrom(pos(0,0,0), slotRoute(s));

  routeEndpointFrom(p, []) = p;
  routeEndpointFrom(p, m |> ms) = routeEndpointFrom(movePos(m, p), ms);
  movePos(m, p) =
    if(
      state(m) == Forward,
      if(
        axis(m) == XAxis,
        pos(x(p) + 1, y(p), z(p)),
        if(axis(m) == YAxis, pos(x(p), y(p) + 1, z(p)), pos(x(p), y(p), z(p) + 1))
      ),
      if(
        state(m) == Backward,
        if(
          axis(m) == XAxis,
          pos(x(p) - 1, y(p), z(p)),
          if(axis(m) == YAxis, pos(x(p), y(p) - 1, z(p)), pos(x(p), y(p), z(p) - 1))
        ),
        p
      )
    );

  slotAmount = 3;

  (s >= slotAmount) -> find_empty(s, occ) = slotAmount;
  (s < slotAmount) && !(s in occ) -> find_empty(s, occ) = s;
  (s < slotAmount) && (s in occ) -> find_empty(s, occ) = find_empty(s + 1, occ);

act
  engageGripper, disengageGripper, requestStorage, emergencyPressed,
  emergencyReleased, clearHandoff, handoffCleared;
  setMovement : Movement; gridReached : Position;
  setEmergencyLight, objectAtPickup, objectInGripper: Bool;
  requestRetrieval: Nat; setDisplay: DisplayValue; 
  s_armEmergency, r_armEmergency, comm_armEmergency,
  s_armRecovery, r_armRecovery, comm_armRecovery,
  s_requestStoreSlot, r_requestStoreSlot, comm_requestStoreSlot,
  s_operationCompleted, r_operationCompleted, comm_operationCompleted,
  s_handoffBusy, r_handoffBusy, comm_handoffBusy,
  s_opAllowed, r_opAllowed, comm_opAllowed,
  s_opDone, r_opDone, comm_opDone,
  s_handoffClear, r_handoffClear, comm_handoffClear;
  s_armCompleted, r_armCompleted, comm_armCompleted;
  s_armRejected, r_armRejected, comm_armRejected,
  s_rejectRequest, r_rejectRequest, comm_rejectRequest: Rejection;
  s_acceptRequest, r_acceptRequest, comm_acceptRequest,
  s_requestPickupSlot, r_requestPickupSlot, comm_requestPickupSlot,
  s_armMoveToSlot, r_armMoveToSlot, comm_armMoveToSlot,
  s_armRequestReturn, r_armRequestReturn, comm_armRequestReturn: Slot;
  s_armRequestPickup, r_armRequestPickup, comm_armRequestPickup;
  s_armRequestHandoff, r_armRequestHandoff, comm_armRequestHandoff: Bool;

proc

  EmergencyController(isEmergency: Bool) =
    (
      !(isEmergency) ->
      (
        (emergencyPressed . setEmergencyLight(true) . s_armEmergency . EmergencyController(true))
        +
        (s_opAllowed . r_opDone . EmergencyController(false))
      )
    )
    +
    (
      isEmergency ->
      (
        emergencyReleased . s_armRecovery . setEmergencyLight(false) . EmergencyController(false)
      )
    );

  UserInterface =
    (
      requestStorage . s_requestStoreSlot .
      (
        (
          sum r: Rejection . r_rejectRequest(r) . setDisplay(reject(r)) . UserInterface
        )
        +
        sum slot: Slot . (slot < slotAmount) ->
          (
            r_acceptRequest(slot) . setDisplay(accept(slot)) . WaitCompleted(slot)
          )
      )
    )
    +
    (
      sum slot: Slot . (slot < slotAmount) ->
        requestRetrieval(slot) . s_requestPickupSlot(slot) .
        (
          (
            sum r: Rejection . r_rejectRequest(r) . setDisplay(reject(r)) . UserInterface
          )
          +
          (
            r_acceptRequest(slot) . setDisplay(accept(slot)) . WaitCompleted(slot)
          )
        )
    )
    +
    (
      r_handoffBusy . setDisplay(reject(HandoffBusy)) . handoffCleared . s_handoffClear . UserInterface
    );

  WaitCompleted(slot: Slot) =
    (
      r_operationCompleted . setDisplay(complete(slot)) . UserInterface
    )
    +
    (
      r_handoffBusy . clearHandoff . setDisplay(reject(HandoffBusy)) . handoffCleared . s_handoffClear . WaitCompleted(slot)
    );

  StorageClearHandoff(
    occupancy: FSet(Slot), slot: Slot, rejection: Rejection
  ) =
    s_armRequestHandoff(false) .
    (
      (
        r_armCompleted .
        (
          (rejection == NoRejection) -> s_operationCompleted <> s_rejectRequest(rejection)
        ) .
        StorageController(occupancy - {slot})
      )
      +
      (
        r_armRejected(HandoffBusy) . s_handoffBusy .
        r_handoffClear . StorageClearHandoff(occupancy, slot, rejection)
      )
    );

  StorageController(occupancy: FSet(Slot)) =
    (
      sum slot: Slot . (slot < slotAmount && slot in occupancy) ->
        (
          r_requestPickupSlot(slot) . s_armMoveToSlot(slot) . r_armCompleted . s_armRequestPickup . 
          (
            (
              r_armCompleted . s_acceptRequest(slot) . s_armRequestReturn(slot)
              . r_armCompleted . StorageClearHandoff(occupancy, slot, NoRejection)
            )
            +
            (
              r_armRejected(NothingToPick) . s_armRequestReturn(slot) . r_armCompleted . s_rejectRequest(NothingToPick) .
              StorageController(occupancy - {slot})
            )
          )
        )
    )
    +
    (
      sum empty_slot: Nat .
      (empty_slot == find_empty(0, occupancy) && empty_slot < slotAmount) ->
        (
          r_requestStoreSlot . s_acceptRequest(empty_slot) . s_armRequestPickup . 
          (
            (
              r_armRejected(NothingToPick) . r_rejectRequest(NothingToPick) . StorageController(occupancy)
            ) +
            (
              r_armCompleted . s_armMoveToSlot(empty_slot) . r_armCompleted . s_armRequestHandoff(true) .
              (
                (
                  r_armCompleted . s_armRequestReturn(empty_slot) . r_armCompleted . s_operationCompleted .
                  StorageController(occupancy + {empty_slot})
                ) +
                (
                  r_armRejected(SlotBusy) . s_armRequestReturn(empty_slot) . r_armCompleted .
                  StorageClearHandoff(occupancy, empty_slot, NoRejection)
                )
              )
            )
          )
        )
    )
    +
    (
      (find_empty(0, occupancy) >= slotAmount) -> 
        r_requestStoreSlot . s_rejectRequest(StorageFull) . StorageController(occupancy)
    )
    +
    (
      sum slot: Slot . (slot < slotAmount && !(slot in occupancy)) -> 
        r_requestPickupSlot(slot) . s_rejectRequest(SlotEmpty) . StorageController(occupancy)
    );


  ArmFollowRoute(route: List(Movement), position: Position) =
    (route == []) ->
      (
        s_armCompleted . ArmController(position)
        +
        r_armEmergency . r_armRecovery . ArmFollowRoute(route, position)
      )
    <>
      (
        (
          r_armEmergency . r_armRecovery . ArmFollowRoute(route, position)
        )
        +
        (
          r_opAllowed . setMovement(head(route)) . s_opDone .
          (
            gridReached(movePos(head(route), position)) . setMovement(movement(axis(head(route)), Stop)) .
            ArmFollowRoute(tail(route), movePos(head(route), position))
            +
            r_armEmergency . setMovement(movement(axis(head(route)), Stop)) .
            r_armRecovery . ArmFollowRoute(route, position)
          )
        )
      );

  ArmEngage(position: Position) = 
    (
      r_armEmergency . r_armRecovery . ArmEngage(position)
    )
    +
    (
      r_opAllowed . engageGripper . s_opDone . s_armCompleted . ArmController(position)
    );

  ArmDisengage(position: Position) = 
    (
      r_armEmergency . r_armRecovery . ArmDisengage(position)
    )
    +
    (
      r_opAllowed . disengageGripper . s_opDone . s_armCompleted . ArmController(position)
    );

  ArmController(position: Position) = 
    (
      r_armEmergency . r_armRecovery . ArmController(position)
    )
    +
    (
      sum s: Slot . r_armMoveToSlot(s). ArmFollowRoute(slotRoute(s), position)
    )
    +
    (
      sum s: Slot . r_armRequestReturn(s) .
      ArmFollowRoute(reverseRoute(slotRoute(s)), position)
    )
    +
    (
      sum s: Slot . r_armRequestPickup . 
      (
        (
          objectAtPickup(true) . ArmEngage(position)
        )
        +
        (
          objectAtPickup(false) . s_armRejected(NothingToPick) . ArmController(position)
        )
      )
    ) 
    +
    (
      sum b: Bool . r_armRequestHandoff(b) . 
      ( % NOTE(Jorens): True - slot, False - handoff.
        (
          objectAtPickup(true) . s_armRejected(if(b, SlotBusy, HandoffBusy)) . ArmController(position)
        )
        +
        (
          objectAtPickup(false) . ArmDisengage(position)
        )
      )
    );

init
  allow(
    {
      setMovement, gridReached, engageGripper, disengageGripper, objectAtPickup, requestStorage, requestRetrieval,
      setDisplay, setEmergencyLight, emergencyPressed, emergencyReleased, clearHandoff, handoffCleared, comm_acceptRequest,
      comm_rejectRequest, comm_requestPickupSlot, comm_requestStoreSlot, comm_operationCompleted, comm_armMoveToSlot,
      comm_armEmergency, comm_armRecovery, comm_armRequestReturn, comm_armRequestPickup, comm_armRequestHandoff,
      comm_armCompleted, comm_handoffBusy, comm_handoffClear, comm_armRejected, comm_opAllowed, comm_opDone
    },
    comm(
      {
        s_acceptRequest | r_acceptRequest -> comm_acceptRequest,
        s_rejectRequest | r_rejectRequest -> comm_rejectRequest,
        s_requestPickupSlot | r_requestPickupSlot -> comm_requestPickupSlot,
        s_requestStoreSlot | r_requestStoreSlot -> comm_requestStoreSlot,
        s_operationCompleted | r_operationCompleted -> comm_operationCompleted,
        s_armMoveToSlot | r_armMoveToSlot -> comm_armMoveToSlot,
        s_armCompleted | r_armCompleted -> comm_armCompleted,
        s_armEmergency | r_armEmergency -> comm_armEmergency,
        s_armRecovery | r_armRecovery -> comm_armRecovery,
        s_armRequestReturn  |  r_armRequestReturn ->  comm_armRequestReturn,
        s_armRequestPickup  |  r_armRequestPickup ->  comm_armRequestPickup,
        s_armRequestHandoff | r_armRequestHandoff -> comm_armRequestHandoff,
        s_handoffBusy | r_handoffBusy -> comm_handoffBusy,
        s_handoffClear | r_handoffClear -> comm_handoffClear,
        s_armRejected    | r_armRejected -> comm_armRejected,
        s_opAllowed | r_opAllowed -> comm_opAllowed,
        s_opDone | r_opDone -> comm_opDone
      },
      (
        EmergencyController(false) || UserInterface || StorageController({}) || ArmController(pos(0,0,0))
      )
    )
  );
