nu X(
  isEmergency: Bool = false,
  motorState: Axis -> MotorState = initMotorState
) .
(
  (
    forall a: Axis . val(motorState(a) != Stop && isEmergency) =>
      nu Z . mu Y . (
        <true>true &&
        (forall s: MotorState . [setMovement(movement(a, s))] val(s == Stop)) &&
        ([emergencyPressed || clearHandoff] Z) &&
        [!(
          (exists s: MotorState . setMovement(movement(a, s))) || 
          emergencyReleased || emergencyPressed || clearHandoff
        )] Y
      )
  ) &&

  (forall a: Axis, s: MotorState . [setMovement(movement(a, s))] X(isEmergency, motorState[a -> s])) &&
  [emergencyPressed] X(true, motorState) &&
  [emergencyReleased] X(false, motorState) &&

  [
    !(
      (exists a: Axis, s: MotorState . setMovement(movement(a, s))) || emergencyPressed || emergencyReleased 
    )
  ] X(isEmergency, motorState)
)
