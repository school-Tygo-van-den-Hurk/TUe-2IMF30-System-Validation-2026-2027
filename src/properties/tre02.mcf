nu X(
  position: Position = pos(0,0,0),
  holding: Held = Nothing
) . (
  (
    val(
      holding != Nothing && ( 
        position == pos(0,0,0) || (exists s: Slot . s < slotAmount && position == slotPosition(s))
      )
    ) => [objectAtPickup(false)] nu Z . mu Y . (
      <true> true &&
      (forall a: Axis, m: MotorState . [setMovement(movement(a, m))] false) &&
      [emergencyPressed || clearHandoff] Z &&
      [!(disengageGripper || emergencyPressed || clearHandoff)] Y
    )
  ) &&

  (forall p: Position . [gridReached(p)] X(p, holding)) &&

  (forall s: Slot . val(s < slotAmount && position == slotPosition(s)) =>
    [engageGripper] X(position, if(holding == Nothing, item(s), holding))
  ) &&
  (!(exists s: Slot . val(s < slotAmount && position == slotPosition(s))) =>
    [engageGripper] X(position, if(holding == Nothing && position == pos(0,0,0), Pickup, holding))
  ) &&
  (forall s: Slot . val(s < slotAmount && position == slotPosition(s)) =>
    [disengageGripper] X(position, if(holding != Nothing, Nothing, holding))
  ) &&
  (!(exists s: Slot . val(s < slotAmount && position == slotPosition(s))) =>
    [disengageGripper] X(position, if(holding != Nothing && position == pos(0,0,0), Nothing, holding))
  ) &&

  [!(engageGripper || disengageGripper || (exists p: Position . gridReached(p)))] X(position, holding)
)
