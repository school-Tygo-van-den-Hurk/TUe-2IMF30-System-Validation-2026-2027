nu X(
  position: Position = pos(0,0,0)
) . (

  (forall s: Slot . val(s < slotAmount && position == slotPosition(s)) => 
    [objectAtPickup(true)] (
      nu Z(p1: Position = position) . mu Y(p2: Position = p1) . (
        [disengageGripper] false &&
        ([objectAtPickup(false)] val(p2 == pos(0,0,0))) &&
        (forall p: Position . [gridReached(p)] Y(p)) &&
        [emergencyPressed || clearHandoff] Z(p2) &&
        [!(
          disengageGripper || objectAtPickup(false) ||
          (exists p: Position . gridReached(p)) || emergencyPressed || clearHandoff
        )] Y(p2)
      )
    )
  ) &&

  (forall p: Position . [gridReached(p)] X(p)) &&

  [!(exists p: Position . gridReached(p))] X(position)
)
