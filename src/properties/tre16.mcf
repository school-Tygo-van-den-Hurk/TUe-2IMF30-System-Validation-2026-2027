nu X(
  occupancy: FSet(Slot) = {},
  position: Position = pos(0,0,0),
  holding: Held = Nothing
) . (

  (val(#occupancy < slotAmount && holding == Nothing) => 
    [requestStorage] (
      nu Z(p1: Position = position) . mu Y(p2: Position = p1) . (
        (forall b: Bool . [objectAtPickup(b)] val(p2 == pos(0,0,0))) &&
        (forall p: Position . [gridReached(p)] Y(p)) &&
        [disengageGripper || engageGripper] false &&
        [emergencyPressed || clearHandoff] Z(p2) &&
        [!(
          (exists b: Bool . objectAtPickup(b)) || (exists p: Position . gridReached(p)) ||
          disengageGripper || engageGripper || emergencyPressed || clearHandoff
        )] Y(p2)
      )
    )
  ) &&

  (forall p: Position . [gridReached(p)] X(occupancy, p, holding)) &&

  (forall s: Slot . val(s < slotAmount && position == slotPosition(s)) =>
    [engageGripper] X(
      if(holding == Nothing && s in occupancy, occupancy - {s}, occupancy),
      position,
      if(holding == Nothing, item(s), holding)
    )
  ) &&
  (!(exists s: Slot . val(s < slotAmount && position == slotPosition(s))) =>
    [engageGripper] X(
      occupancy,
      position,
      if(holding == Nothing && position == pos(0,0,0), Pickup, holding)
    )
  ) &&
  (forall s: Slot . val(s < slotAmount && position == slotPosition(s)) =>
    [disengageGripper] X(
      if(holding != Nothing && !(s in occupancy) && #occupancy < slotAmount, occupancy + {s}, occupancy),
      position,
      if(holding != Nothing, Nothing, holding)
    )
  ) &&
  (!(exists s: Slot . val(s < slotAmount && position == slotPosition(s))) =>
    [disengageGripper] X(
      occupancy,
      position,
      if(holding != Nothing && position == pos(0,0,0), Nothing, holding)
    )
  ) &&

  (forall s: Slot . val(s < slotAmount && position == slotPosition(s)) =>
    [objectAtPickup(false)] X(
      if(holding == Nothing && s in occupancy, occupancy - {s}, occupancy),
      position,
      holding
    )
  ) &&
  (!(exists s: Slot . val(s < slotAmount && position == slotPosition(s))) =>
    [objectAtPickup(false)] X(occupancy, position, holding)
  ) &&

  [
    !(
      objectAtPickup(false) || engageGripper ||
      disengageGripper || (exists p: Position . gridReached(p))
    )
  ] X(occupancy, position, holding)
)

