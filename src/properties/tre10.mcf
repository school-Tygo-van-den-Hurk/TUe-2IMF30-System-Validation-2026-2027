nu X(
  motorState: Axis -> MotorState = initMotorState
) . (
  (forall a1: Axis . val(motorState(a1) != Stop) => 
      (forall a2: Axis . val(a1 != a2) => val(motorState(a2) == Stop))
  ) &&

  (forall a: Axis, s: MotorState . [setMovement(movement(a, s))] X(motorState[a -> s])) &&

  [!(exists a: Axis, s: MotorState . setMovement(movement(a, s)))] X(motorState)
)
