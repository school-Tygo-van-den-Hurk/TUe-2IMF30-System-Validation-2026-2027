nu X(
  mode: Mode = Idle
) .
(
  (val(mode == Emergency) => 
    (
      forall a: Axis .
      [
        setMovement(movement(a, Forward)) +
        setMovement(movement(a, Backward))
      ]false
    )
  ) 
  &&

  [emergencyPressed] X(Emergency) &&
  [emergencyReleased] X(Idle) &&

  [
    !(
      emergencyPressed || emergencyReleased
    )
  ] X(mode)
)
