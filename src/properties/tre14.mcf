nu X(
  readyToEngage: Bool = false,
  readyToDisengage: Bool = false
) . (
  [engageGripper] val(readyToEngage) &&
  [disengageGripper] val(readyToDisengage) &&
 
  (forall a: Axis . forall s: MotorState .
    [setMovement(movement(a, s))]
      X(if(s == Stop, readyToEngage, false), if(s == Stop, readyToDisengage, false))
  ) &&
  (forall b: Bool . [objectAtPickup(b)] X(b, !b)) &&

  [!(
    (exists b: Bool . objectAtPickup(b)) || (exists a: Axis, m: MotorState . setMovement(movement(a, m)))
  )] X(readyToEngage, readyToDisengage)
)
