nu X(
  motorState: Axis -> MotorState = initMotorState,
  readyToEngage: Bool = false,
  readyToDisengage: Bool = false
) . (
  [engageGripper] val(readyToEngage) &&
  [disengageGripper] val(readyToDisengage) &&
 
  (forall a: Axis . forall s: MotorState .
    [setMovement(movement(a, s))]
      X(
        motorState[a -> s],
        if(s == Stop, readyToEngage,    false),
        if(s == Stop, readyToDisengage, false)
      )
  ) &&
  (forall b: Bool .
    [objectAtPickup(b)]
      X(
        motorState,
         b && (forall a: Axis . motorState(a) == Stop),
        !b && (forall a: Axis . motorState(a) == Stop)
      )
  ) &&

  [!(
    (exists b: Bool . objectAtPickup(b)) || (exists m: Movement . setMovement(m))
  )] X(motorState, readyToEngage, readyToDisengage)
)
