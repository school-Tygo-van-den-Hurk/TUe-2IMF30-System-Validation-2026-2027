nu X(
  occupancy: FSet(Slot) = {},
  position: Position = pos(0,0,0),
  holding: Held = Nothing
) . (

  (forall s : Slot . val(s < slotAmount && s in occupancy && holding == Nothing) => 
    [requestRetrieval(s)] (
      nu Z(p1: Position = position) . mu Y(p2: Position = p1) . (
        (forall b: Bool . [objectAtPickup(b)] val(p2 == slotPosition(s))) &&
        (forall p: Position . [gridReached(p)] Y(p)) &&
        [disengageGripper || engageGripper] false &&
        [emergencyPressed || clearHandoff] Z(p2) &&
        [!(
          (exists b: Bool . objectAtPickup(b)) || (exists p: Position . gridReached(p)) ||
          disengageGripper || engageGripper || emergencyPressed || clearHandoff
        )] Y(p2)
      )
    )
  ) &&

  (forall p: Position . [gridReached(p)] X(occupancy, p, holding)) &&

  (val(holding == Nothing && position == pos(0,0,0)) => 
      [engageGripper] X(occupancy, position, Pickup)
  ) &&
  (forall s: Slot . val(holding == Nothing && s < slotAmount && position == slotPosition(s) && s in occupancy) =>
      [engageGripper] X(occupancy - {s}, position, item(s))
  ) &&
  (val(holding != Nothing && position == pos(0,0,0)) => 
      [disengageGripper] X(occupancy, position, Nothing)
  ) &&
  (forall s: Slot . val(holding != Nothing && s < slotAmount && position == slotPosition(s)) =>
      [disengageGripper] 
      X(
        if(!(s in occupancy) && #occupancy < slotAmount, occupancy + {s}, occupancy),
        position, 
        Nothing
      )
  ) &&

  (forall s: Slot . val(s < slotAmount && position == slotPosition(s)) =>
    [objectAtPickup(false)] X(if(holding == Nothing, occupancy - {s}, occupancy), position, holding)
  ) &&
  (val(position == pos(0,0,0)) =>
    [objectAtPickup(false)] X(occupancy, position, holding)
  ) &&

  [
    !(
      objectAtPickup(false) || engageGripper ||
      disengageGripper || (exists p: Position . gridReached(p))
    )
  ] X(occupancy, position, holding)
)
