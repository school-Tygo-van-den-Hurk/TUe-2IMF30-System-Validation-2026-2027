nu X(
  occupancy: FSet(Slot) = {},
  position: Position = pos(0,0,0),
  holding: Held = Nothing
) . (

  (val(#occupancy >= slotAmount) =>
    [requestStorage] nu Z . mu Y . (
      <true> true &&
      (forall d: DisplayValue . [setDisplay(d)] val(d == reject(StorageFull))) &&
      [engageGripper || disengageGripper || objectAtPickup(false)] false &&
      [emergencyPressed || clearHandoff] Z &&
      [!(setDisplay(reject(StorageFull)) || emergencyPressed || clearHandoff)] Y
    )
  ) &&

  (forall p: Position . [gridReached(p)] X(occupancy, p, holding)) &&

  (forall s: Slot . val(s < slotAmount && position == slotPosition(s)) =>
    [engageGripper] X(
      if(holding == Nothing && s in occupancy, occupancy - {s}, occupancy),
      position,
      if(holding == Nothing, item(s), holding)
    )
  ) &&
  (!(exists s: Slot . val(s < slotAmount && position == slotPosition(s))) =>
    [engageGripper] X(
      occupancy,
      position,
      if(holding == Nothing && position == pos(0,0,0), Pickup, holding)
    )
  ) &&
  (forall s: Slot . val(s < slotAmount && position == slotPosition(s)) =>
    [disengageGripper] X(
      if(holding != Nothing && !(s in occupancy) && #occupancy < slotAmount, occupancy + {s}, occupancy),
      position,
      if(holding != Nothing, Nothing, holding)
    )
  ) &&
  (!(exists s: Slot . val(s < slotAmount && position == slotPosition(s))) =>
    [disengageGripper] X(
      occupancy,
      position,
      if(holding != Nothing && position == pos(0,0,0), Nothing, holding)
    )
  ) &&

  (forall s: Slot . val(s < slotAmount && position == slotPosition(s)) =>
    [objectAtPickup(false)] X(
      if(holding == Nothing && s in occupancy, occupancy - {s}, occupancy),
      position,
      holding
    )
  ) &&
  (!(exists s: Slot . val(s < slotAmount && position == slotPosition(s))) =>
    [objectAtPickup(false)] X(occupancy, position, holding)
  ) &&

  [!(
    objectAtPickup(false) || engageGripper || disengageGripper || (exists p: Position . gridReached(p))
  )] X(occupancy, position, holding)
)
